# Deployment Configuration for Oracle Cloud ARM AI Server
# Copy this file to .env and adjust credentials before starting

# Code-Server web access password
CODE_SERVER_PASSWORD=change_this_strong_password_123

# Host Ollama endpoint accessible from inside Docker containers
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Open-WebUI secret key (generate with: openssl rand -hex 32)
WEBUI_SECRET_KEY=generate_random_secret_here

# Open-WebUI auth toggle (true: requires registration/login; false: open)
WEBUI_AUTH=true

# Host data directory where all container persistent data is stored
DATA_DIR=/opt/cloud-fleet/data
